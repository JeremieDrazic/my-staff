-export async function listOrders(customerId: string) {
-  return db.query('SELECT * FROM orders WHERE customer_id = $1', [customerId])
+export async function listOrders(customerId: string, sort?: string) {
+  const direction = sort === 'desc' ? 'DESC' : 'ASC'
+  return db.query(
+    `SELECT * FROM orders WHERE customer_id = $1 ORDER BY created_at ${direction}`,
+    [customerId],
+  )
+}
+
+export async function cancelOrder(orderId: string, actorId: string) {
+  await db.query('UPDATE orders SET status = $1 WHERE id = $2', ['cancelled', orderId])
+  try {
+    await audit.record({ action: 'order.cancelled', orderId, actorId })
+  } catch {}
+  return { ok: true }
+}
+
+export async function searchOrders(term: string) {
+  return db.query(`SELECT * FROM orders WHERE reference LIKE '%${term}%'`)
